{
  "name": "@solteq-excom/medusa-fulfillment-nshift",
  "version": "0.1.0",
  "description": "nShift Checkout fulfillment provider plugin for Medusa V2",
  "keywords": [
    "medusa",
    "medusa-v2",
    "medusa-plugin",
    "medusa-fulfillment",
    "nshift",
    "shipping",
    "fulfillment"
  ],
  "files": [
    ".medusa",
    "!.medusa/server/src/admin/**"
  ],
  "author": "Solteq",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SolteqExperienceCommerce/medusa-fulfillment-nshift.git"
  },
  "bugs": {
    "url": "https://github.com/SolteqExperienceCommerce/medusa-fulfillment-nshift/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./package.json": "./package.json",
    "./providers/*": "./.medusa/server/src/providers/*/index.js",
    "./*": "./.medusa/server/src/*.js"
  },
  "scripts": {
    "build": "medusa plugin:build",
    "prepare": "cross-env NODE_ENV=production yarn build",
    "watch": "medusa plugin:build --watch",
    "develop": "medusa plugin:develop",
    "prepack": "node scripts/prepack-clean.js",
    "publish:local": "medusa plugin:publish",
    "test:unit": "cross-env TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit"
  },
  "devDependencies": {
    "@medusajs/admin-sdk": "^2.13.3",
    "@medusajs/cli": "^2.13.3",
    "@medusajs/framework": "^2.13.3",
    "@medusajs/medusa": "^2.13.3",
    "@medusajs/test-utils": "^2.13.3",
    "@swc/core": "^1.7.28",
    "@swc/jest": "^0.2.36",
    "@types/jest": "^29.5.13",
    "@types/node": "^20.12.11",
    "cross-env": "^10.1.0",
    "jest": "^29.7.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2",
    "yalc": "^1.0.0-pre.53"
  },
  "peerDependencies": {
    "@medusajs/admin-sdk": "^2.13.3",
    "@medusajs/cli": "^2.13.3",
    "@medusajs/framework": "^2.13.3",
    "@medusajs/medusa": "^2.13.3",
    "@medusajs/test-utils": "^2.13.3"
  },
  "dependencies": {}
}
